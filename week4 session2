import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {

            String s = sc.next();

            int n = s.length();

            int[] first = new int[26];
            int[] second = new int[26];

            
            for (int i = 0; i < n / 2; i++) {
                first[s.charAt(i) - 'a']++;
            }

           
            for (int i = (n + 1) / 2; i < n; i++) {
                second[s.charAt(i) - 'a']++;
            }

           
            boolean isLapindrome = true;

            for (int i = 0; i < 26; i++) {
                if (first[i] != second[i]) {
                    isLapindrome = false;
                    break;
                }
            }

            if (isLapindrome) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }

        sc.close();
    }
}
