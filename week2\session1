import java.util.Arrays;

public class BuildArrayPermutation {
    public static int[] buildArray(int[] nums) {
        int n = nums.length;
        int[] ans = new int[n];

        for (int i = 0; i < n; i++) {
            ans[i] = nums[nums[i]];
        }
        return ans;
    }

    public static void main(String[] args) {
        int[] nums1 = {0, 2, 1, 5, 3, 4};
        int[] nums2 = {5, 0, 1, 2, 3, 4};

        System.out.println(Arrays.toString(buildArray(nums1))); // [0,1,2,4,5,3]
        System.out.println(Arrays.toString(buildArray(nums2))); // [4,5,0,1,2,3]
    }
}
Input:  
nums = [0,2,1,5,3,4]

Output:  
[0,1,2,4,5,3]
